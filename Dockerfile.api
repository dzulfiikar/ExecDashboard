FROM maven:3.9.9-eclipse-temurin-17 as builder

WORKDIR /build

# Copy pom files
COPY pom.xml .
COPY exec-core/pom.xml exec-core/
COPY exec-analysis/pom.xml exec-analysis/
COPY exec-api/pom.xml exec-api/
COPY exec-ui/pom.xml exec-ui/
COPY pmd.xml .

# Download dependencies
RUN mvn dependency:go-offline -B || true

# Copy source code
COPY exec-core/src exec-core/src
COPY exec-analysis/src exec-analysis/src
COPY exec-api/src exec-api/src

# Build the project
RUN mvn clean package -Dpmd.skip=true -pl exec-core,exec-analysis,exec-api

# API Image
FROM eclipse-temurin:17-jre as api
EXPOSE 8080
VOLUME /var/app/config
COPY --from=builder /build/exec-api/target/exec-api.jar /var/app/app.jar
ENTRYPOINT ["java","-Djava.security.egd=file:/dev/./urandom","-jar","/var/app/app.jar"]
CMD [ "--spring.config.location=/var/app/config/application.properties" ]
